{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth/[action]"
    },
    {
      "source": "/api/billing/:action",
      "destination": "/api/billing/[action]"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
